# =============================================================================
# Eclipse Store — exemplo de variáveis de ambiente
# Copie para ".env" e preencha. NUNCA commitar o arquivo .env preenchido.
# =============================================================================

# --- Discord -----------------------------------------------------------------
# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=cole-aqui-o-token-do-bot
# ID numérico do dono da loja (Discord: Modo Desenvolvedor > clicar no usuário)
OWNER_ID=0
# IDs extras com poder de administrador da loja (opcional, separados por vírgula)
ADMIN_IDS=
# Guild (servidor) usada em desenvolvimento para publicar comandos na hora.
# Deixe vazio em produção (comandos globais).
DEV_GUILD_ID=

# --- Stripe ------------------------------------------------------------------
# Chave secreta da API (teste: sk_test_... / produção: sk_live_...)
STRIPE_SECRET_KEY=sk_test_cole-aqui
# Segredo do endpoint de webhook (whsec_...) — Dashboard ou `stripe listen`
STRIPE_WEBHOOK_SECRET=whsec_cole-aqui

# --- Servidor web local (recebe webhooks do Stripe) --------------------------
STRIPE_WEBHOOK_HOST=0.0.0.0
STRIPE_WEBHOOK_PORT=8927
# URL pública alcançável pelo Stripe (ex.: https://seudominio.com).
# Usada como base do caminho /stripe/webhook e das páginas de sucesso/cancelamento.
PUBLIC_BASE_URL=

# --- Banco de dados e arquivos ------------------------------------------------
DATABASE_PATH=data/eclipse.db
DELIVERABLES_DIR=data/deliverables
BACKUP_DIR=data/backups
BACKUP_KEEP=14

# --- Negócio -------------------------------------------------------------------
# Moeda inicial (código ISO 4217). Valores sempre em centavos inteiros.
CURRENCY=BRL
# Minutos que uma reserva de estoque aguarda pagamento Stripe antes de liberar
RESERVATION_TTL_MINUTES=30
# Canal de logs privado padrão (opcional; pode ser definido por /config logs)
LOG_CHANNEL_ID=
